# FinGuide+ — Environment Variables
# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

# ---- General ----
APP_NAME=FinGuide+
ENVIRONMENT=development
DEBUG=true

# ---- Backend / API ----
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database ----
# Used directly by docker-compose to configure the `db` service.
POSTGRES_USER=finguide
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=finguide

# Used by the backend app (SQLAlchemy/Alembic). When running the backend
# natively (not via docker compose), point this at localhost. When running
# via docker compose, the backend service overrides this to use the `db`
# hostname automatically — you don't need to change it for that case.
DATABASE_URL=postgresql+psycopg://finguide:replace-with-a-random-local-password@localhost:5432/finguide

# Required outside development. Generate at least 32 random characters.
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Frontend ----
# Read by Vite (must be prefixed with VITE_ to be exposed to the client).
VITE_API_BASE_URL=http://localhost:8000

# ---- Chat provider (backend only) ----
# Choose rule_based, openai, or gemini. Users must consent before external AI processing.
CHATBOT_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
EODHD_API_TOKEN=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=700
CHATBOT_MAX_CONTEXT_CHARS=18000

# Optional: local-only FinBERT weights directory. No downloads occur at runtime.
INSTALL_FINBERT=false
FINBERT_MODEL_PATH=/app/models/finbert
FINBERT_MODEL_VERSION=ProsusAI/finbert
